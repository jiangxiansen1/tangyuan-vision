# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.local

# Vite
.vite/
node_modules/.tmp/

# Verification artifacts produced by tools/ — regenerated on demand, never shipped.
tools/_verify/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Local environment overrides
.env
.env.*
!.env.example

# TypeScript incremental build state
*.tsbuildinfo

# NOTE: dist/ is ignored because GitHub Actions builds it. If you prefer to commit
# the built site instead (for a branch-based Pages deploy), remove that line.
#
# NOTE: public/assets/audio/ambient.wav is ~2.2 MB of generated audio. It IS
# committed so the music toggle works out of the box. If you would rather not
# carry it, delete the file and add it here — the site handles its absence and
# reports it in the UI rather than failing.

# Texture download cache for tools/build-earth-textures.cjs. Re-fetchable, so it
# is not part of the source tree.
tools/_earth-src/

# Local Supabase CLI state (created if the operator runs `supabase start`).
supabase/.temp/
supabase/.branches/

# Temporary probe wrappers written into public/ by tools/audit-*.cjs and
# tools/verify-*.cjs while measuring a running site. They exist for the duration of
# a check and must never be published.
public/__*

# Natural Earth source GeoJSON (tens of MB). Re-fetchable, and never shipped in the
# front-end bundle. The DERIVED files that ARE shipped live in
# public/assets/earth/admin1/ and src/features/earth/data/. See docs/DATA_SOURCES.md.
tools/_data/


# Python 缓存（导入脚本运行时会生成）
tools/__pycache__/
*.pyc
