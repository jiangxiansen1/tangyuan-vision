# =============================================================================
#  .env.example — 环境变量模板
# =============================================================================
#
#  用法：复制成 .env 再填值（.env 已被 .gitignore 忽略，不会被提交）。
#
#      cp .env.example .env
#
#  ⚠️ 先读完这一段再填任何东西。这里有一个必须理解的区分：
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │  VITE_* 变量**不是**秘密。它们在 `vite build` 时被**内联进 JS 产物**，  │
#  │  任何访客打开 devtools、抓一次请求，都能读到它们。                       │
#  │                                                                         │
#  │  所以下面两个值都是**设计上公开**的：Supabase 的项目 URL 和 anon key。   │
#  │  它们本来就要发给浏览器，写进代码里不算泄露。                            │
#  │                                                                         │
#  │  真正保护数据的是数据库里的 **Row Level Security**，不是"把 key 藏起来"。│
#  │  本项目的 RLS 在 supabase/migrations/ 里，逐条写了理由。                │
#  └─────────────────────────────────────────────────────────────────────────┘
#
#  ✗ 绝对不要放进这里的值（放进来就等于把数据库交出去）：
#      · service_role key（它**绕过 RLS**，只属于服务端，永远不进前端）
#      · 数据库密码（DATABASE_URL / postgres://…）
#      · JWT secret、GitHub token、任何 OAuth client secret
#    这三类东西出现在仓库或 VITE_* 里，等同于公开泄露，且无法通过"删掉提交"
#    挽回——Git 历史和 CDN 缓存都还记得。
#
#  不填也能跑：两个变量留空时，站点照常工作，点赞/投票区域显示
#  "未配置"状态并明确说明原因，**不会**显示任何编造的数字。
#  这是刻意的设计（见 docs/CONTENT.md 的诚实性约定）。
# =============================================================================


# -----------------------------------------------------------------------------
#  1. 公开值（可从浏览器读取）
# -----------------------------------------------------------------------------

# Supabase 项目 URL。
#   在哪找：Supabase Dashboard → 你的项目 → Project Settings → Data API
#           → "Project URL"，形如 https://abcdefghijklmnop.supabase.co
#   注意：  结尾**不要**加斜杠。
VITE_SUPABASE_URL=

# Supabase 的 anon（匿名）key，也叫 publishable key。
#   在哪找：Supabase Dashboard → 你的项目 → Project Settings → API Keys
#           → "anon" / "public" 那一条（一长串 JWT，或 sb_publishable_… 形式）
#   ⚠️ 名字里的 "public" 是字面意思：这个 key 会被内联进前端产物并公开。
#      它能做什么**完全**由数据库的 RLS 决定：
#        · 能读聚合计数（通过 security definer 函数）
#        · 能插入点赞/投票（受 UNIQUE 约束和时间窗限流）
#        · 不能读任何一行原始记录（visitor_hash 不可枚举）
#        · 不能 update、不能 delete 别人的行
#      如果你在这里填的是 service_role key，上述全部防线立刻失效。
#      填之前确认那一条的标题是 anon / public，**不是** service_role。
VITE_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
#  2. 可选值
# -----------------------------------------------------------------------------

# 访客去重令牌的盐。留空会退化为一个内置常量盐。
#   作用：让 visitor_hash = SHA-256(本地随机 UUID + salt) 在**换项目**之后
#         不可复用（否则同一个 UUID 在两个 Supabase 项目里会算出同一个 hash）。
#   它**不是**秘密：这个值同样会被内联进产物。
#   建议：随便一串你喜欢的文字，或者换一个 Supabase 项目时改一次。
#   为什么要有它：没有盐的话，如果将来某天数据库真的泄露，
#   "用一个随机 UUID 反查"是做不到的（UUID 空间太大），但"用同一套算法
#   复现某个已知 UUID"是可以的——盐把那一步也堵上。仅此而已，不要高估它。
VITE_VISITOR_SALT=

# DEMO 模式开关。**只在 `pnpm dev` 下有效**，生产构建里这个变量会被忽略。
#   设成 1 后，开发服务器会把点赞/投票接到内存里的假后端（src/lib/interactions/demo.ts）。
#   为什么要有：真实后端没配好时，也需要能调 UI 的加载/错误/已点过 状态。
#   为什么是安全的：能进入 DEMO 的唯一路径是
#       import.meta.env.DEV === true  &&  VITE_TV_DEMO === '1'  &&  地址带 ?demo=1
#   生产构建里 import.meta.env.DEV 是**编译期常量 false**，Vite/Rollup 会把
#   整个 DEMO 分支折叠掉，demo.ts 不会进入产物（见 src/lib/interactions/demo.ts 顶部注释）。
#   DEMO 数据在界面上必须显示 "DEMO" 标记，且永远不会写进数据库。
VITE_TV_DEMO=

# -----------------------------------------------------------------------------
#  3. 部署时怎么给 GitHub Actions 这两个值
# -----------------------------------------------------------------------------
#  GitHub Pages 的构建在 Actions 里跑，**读不到你本机的 .env**。
#  两种给法（都不涉及任何秘密，所以两种都可以用）：
#
#    仓库 → Settings → Secrets and variables → Actions → Variables → New repository variable
#      Name: VITE_SUPABASE_URL        Value: https://xxx.supabase.co
#      Name: VITE_SUPABASE_ANON_KEY   Value: eyJhbGciOi...
#
#    Actions 会把这些变量注入构建环境，Vite 随即内联进产物。
#    因为值是公开的，用 Variables（不是 Secrets）也完全安全；
#    用 Secrets 也可以，只是没必要——把它当成秘密容易让人误以为
#    "前端有秘密"，而前端没有秘密。
#
#  ⚠️ 换 key 之后必须重新部署：值是**构建期内联**的，改仓库变量不会
#     影响已经发布出去的产物。
# -----------------------------------------------------------------------------
